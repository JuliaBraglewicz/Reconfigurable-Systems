<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_modulo_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_modulo" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="66.501 ns"></ZoomEndTime>
      <Cursor1Time time="0.003 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="91"></NameColumnWidth>
      <ValueColumnWidth column_width="72"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="5" />
   <wvobject fp_name="/tb_modulo/cnt1" type="array">
      <obj_property name="ElementShortName">cnt1[2:0]</obj_property>
      <obj_property name="ObjectShortName">cnt1[2:0]</obj_property>
      <obj_property name="isExpanded"></obj_property>
   </wvobject>
   <wvobject fp_name="/tb_modulo/cnt2" type="array">
      <obj_property name="ElementShortName">cnt2[3:0]</obj_property>
      <obj_property name="ObjectShortName">cnt2[3:0]</obj_property>
      <obj_property name="isExpanded"></obj_property>
   </wvobject>
   <wvobject fp_name="/tb_modulo/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_modulo/ce" type="logic">
      <obj_property name="ElementShortName">ce</obj_property>
      <obj_property name="ObjectShortName">ce</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_modulo/rst" type="logic">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
</wave_config>
